{
	"schemaVersion": 1,
	"node": "24.22.3",
	"pnpm": "11.28.12",
	"rust": "1.100.0",
	"cargoAudit": "0.23.0",
	"rustComponents": ["rustfmt", "clippy"],
	"target": {
		"platform": "linux",
		"arch": "x64"
	},
	"pkgConfig": {
		"gtk+-3.0": "libgtk-3-dev",
		"webkit2gtk-4.1": "libwebkit2gtk-4.1-dev",
		"librsvg-2.0": "librsvg2-dev",
		"ayatana-appindicator3-0.1": "libayatana-appindicator3-dev",
		"openssl": "libssl-dev"
	},
	"nativeCommands": {
		"pkg-config": ["--version"],
		"patchelf": ["--version"],
		"objcopy": ["--version"],
		"readelf": ["--version"],
		"cc": ["--version"],
		"c++": ["--version"]
	},
	"webRequirementNames": ["node", "pnpm", "locks", "workspaces", "chromium"],
	"automaticInstallation": false
}
