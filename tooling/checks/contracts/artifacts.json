{
	"schemaVersion": 1,
	"candidatePayloads": [
		"store",
		"cache",
		"npm-cache",
		"source/node_modules",
		"source/apps/web/node_modules",
		"source/apps/desktop/node_modules",
		"source/packages/notfeed/node_modules",
		"source/apps/web/.svelte-kit",
		"source/apps/web/build",
		"source/apps/desktop/src-tauri/target",
		"source/apps/desktop/src-tauri/gen"
