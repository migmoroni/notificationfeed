{
	"schemaVersion": 1,
	"runner": "ubuntu-24.04",
	"architecture": "x64",
	"integrationBranch": "main",
	"events": ["pull_request", "push", "workflow_dispatch"],
	"actions": [
		{
			"name": "actions/checkout",
			"version": "v6",
			"revision": "d23441a48e516b6c34aea4fa41551a30e30af803"
		},
		{
			"name": "actions/setup-node",
			"version": "v6",
			"revision": "249970729cb0ef3589644e2896645e5dc5ba9c38"
		},
		{
			"name": "actions/upload-artifact",
			"version": "v6",
			"revision": "b7c566a772e6b6bfb58ed0dc250532a479d7789f"
		}
	],
	"jobs": ["web"],
	"permissions": {
		"contents": "read"
	},
	"retentionDays": 14,
	"workflow": ".github/workflows/verify.yml",
	"name": "Verify",
	"repository": "migmoroni/notificationfeed",
	"mutableDocumentation": ["docs/**/state.md"],
	"cache": {
		"manager": "pnpm",
		"inputs": [
			"pnpm-lock.yaml",
			"pnpm-workspace.yaml",
			".nvmrc",
			"rust-toolchain.toml",
			"apps/desktop/src-tauri/Cargo.lock",
			"package.json",
			"mise.toml",
			"mise.lock",
			".mise/locks/**",
			"tooling/setup/install-mise.sh",
			"tooling/checks/contracts/provision.json"
		],
		"nativeTarget": false,
		"frozenInstallRequired": true,
		"toolInstallations": false,
		"setupNodePurpose": "pnpm cache only; no node-version or node-version-file inputs"
	},
	"receipt": {
		"schemaVersion": 1,
		"required": [
			"runId",
			"attempt",
			"url",
			"event",
			"headSha",
			"checkoutSha",
			"inputHash",
			"contractsHash",
			"locks",
			"jobs",
			"artifacts"
		],
		"artifactNames": ["proof-web"],
		"publishedAppImage": false,
		"scopeRequiredForQualification": "web-minimum"
	},
	"service": {
		"apiVersion": "2026-03-10",
		"mode": "read-only verification",
		"headRelation": "PR checkout equals head or has exactly base/head parents; other events checkout equals head",
		"download": "Fresh metadata plus ZIP SHA256 and extracted proof manifests; no manual status acceptance",
		"requiredAttempt": "The web job and its proof artifact from the same successful run attempt"
	},
	"provisioning": {
		"contract": "tooling/checks/contracts/provision.json",
		"bootstrap": "tooling/setup/install-mise.sh",
		"bootstrapReceipt": ".artifacts/setup/bootstrap.json",
		"freshDataMarker": ".artifacts/setup/mise-data-fresh.stdout",
		"requireFreshData": true,
		"requireFreshDependencies": true,
		"setups": {
			"web": "mise run setup:ci"
		},
		"environment": {
			"MISE_DATA_DIR": "${{ runner.temp }}/notfeed-mise/data",
			"MISE_CACHE_DIR": "${{ runner.temp }}/notfeed-mise/cache",
			"MISE_CONFIG_DIR": "${{ runner.temp }}/notfeed-mise/config",
			"MISE_STATE_DIR": "${{ runner.temp }}/notfeed-mise/state"
		},
		"bootstrapInstallDirectory": "$RUNNER_TEMP/notfeed-mise/bin",
		"setupTargets": {
			"web": "ci"
		}
	},
	"sources": [
		"https://github.com/actions/setup-node/blob/249970729cb0ef3589644e2896645e5dc5ba9c38/src/main.ts",
		"https://github.com/actions/setup-node/blob/249970729cb0ef3589644e2896645e5dc5ba9c38/action.yml"
	],
	"scope": "web-minimum",
	"toolingTests": [
		"tooling/checks/tests/ci-contract.test.mjs",
		"tooling/checks/tests/ci.test.mjs",
		"tooling/checks/tests/ci-live.test.mjs",
		"tooling/checks/tests/ci-provision.test.mjs",
		"tooling/checks/tests/provision-contract.test.mjs",
		"tooling/checks/tests/provision.test.mjs"
	],
	"checks": [
		{
			"id": "TYPES",
			"command": "pnpm",
			"args": ["check"],
			"typeReport": true
		},
		{
			"id": "E2E-TYPES",
			"command": "pnpm",
			"args": ["check:e2e"]
		},
		{
			"id": "LINT",
			"command": "pnpm",
			"args": ["lint"]
		},
		{
			"id": "FORMAT",
			"command": "pnpm",
			"args": ["format:check"]
		},
		{
			"id": "ARCHITECTURE",
			"command": "pnpm",
			"args": ["check:architecture"]
		},
		{
			"id": "RESTRICTIONS",
			"command": "pnpm",
			"args": ["check:restrictions"]
		},
		{
			"id": "CONTRACTS",
			"command": "pnpm",
			"args": ["check:contracts"]
		},
		{
			"id": "UNIT",
			"command": "pnpm",
			"args": ["test:run"],
			"unitReport": true
		},
		{
			"id": "CI-TOOLING",
			"command": "node",
			"args": [
				"--test",
				"--test-reporter=tap",
				"--experimental-test-isolation=none",
				"tooling/checks/tests/ci-contract.test.mjs",
				"tooling/checks/tests/ci.test.mjs",
				"tooling/checks/tests/ci-live.test.mjs",
				"tooling/checks/tests/ci-provision.test.mjs",
				"tooling/checks/tests/provision-contract.test.mjs",
				"tooling/checks/tests/provision.test.mjs"
			]
		},
		{
			"id": "BUILD",
			"command": "pnpm",
			"args": ["build"]
		}
	],
	"deferredUntilStage3Close": [
		"remote-browser-and-pwa-upgrade",
		"remote-rust-and-native-package",
		"impact-matrix-for-final-modules"
	],
	"stepOrder": ["checkout", "system", "tools", "cache", "setup", "verify", "proof"],
	"systemPackages": ["ca-certificates", "curl", "git", "tar", "xz-utils"]
}
