{
	"schemaVersion": 1,
	"runner": "ubuntu-24.04",
	"architecture": "x64",
	"integrationBranch": "main",
	"events": ["pull_request", "push", "workflow_dispatch"],
	"actions": [
		{
			"name": "actions/checkout",
			"version": "v6",
			"revision": "d23441a48e516b6c34aea4fa41551a30e30af803"
		},
		{
			"name": "actions/setup-node",
			"version": "v6",
			"revision": "249970729cb0ef3589644e2896645e5dc5ba9c38"
		},
		{
			"name": "actions/upload-artifact",
			"version": "v6",
			"revision": "b7c566a772e6b6bfb58ed0dc250532a479d7789f"
		}
	],
	"jobs": ["impact", "web", "desktop", "integration"],
	"permissions": {
		"contents": "read"
	},
	"retentionDays": 14,
	"nativePackages": [
		"libwebkit2gtk-4.1-dev",
		"libgtk-3-dev",
		"librsvg2-dev",
		"libayatana-appindicator3-dev",
		"libssl-dev",
		"pkg-config",
		"patchelf",
		"binutils"
	],
	"workflow": ".github/workflows/verify.yml",
	"name": "Verify",
	"repository": "migmoroni/notificationfeed",
	"fullRequestMarker": "<!-- notfeed-ci:full -->",
	"mutableDocumentation": ["docs/**/state.md"],
	"profiles": {
		"docs": ["impact", "integration"],
		"complete": ["impact", "web", "desktop", "integration"]
	},
	"cache": {
		"manager": "pnpm",
		"inputs": [
			"pnpm-lock.yaml",
			"pnpm-workspace.yaml",
			".nvmrc",
			"rust-toolchain.toml",
			"apps/desktop/src-tauri/Cargo.lock"
		],
		"nativeTarget": false,
		"frozenInstallRequired": true
	},
	"nativeEnvironment": {
		"CARGO_BUILD_JOBS": "2",
		"CARGO_INCREMENTAL": "0",
		"CARGO_PROFILE_DEV_DEBUG": "0",
		"CARGO_PROFILE_TEST_DEBUG": "0"
	},
	"receipt": {
		"schemaVersion": 1,
		"required": [
			"runId",
			"attempt",
			"url",
			"event",
			"headSha",
			"checkoutSha",
			"inputHash",
			"contractsHash",
			"locks",
			"jobs",
			"artifacts"
		],
		"fullRequiredForQualification": true,
		"artifactNames": ["proof-web", "proof-desktop"],
		"publishedAppImage": false
	},
	"impact": "Documentation-only gets links/diff. Runtime, shared, contracts, locks, toolchains, CI, native or unknown gets full consumers. Missing comparison history or explicit full request gets complete.",
	"service": {
		"apiVersion": "2026-03-10",
		"mode": "read-only verification",
		"headRelation": "PR checkout equals head or has exactly base/head parents; other events checkout equals head",
		"download": "Fresh metadata plus ZIP SHA256 and extracted proof manifests; no manual status acceptance",
		"requiredAttempt": "All required jobs and both artifacts from the same complete run attempt"
	}
}
