		"globalDefaults": false,
		"shellEdits": false,
		"automaticApt": false,
		"changeHome": false,
		"doctorInstalls": false,
		"docker": false,
		"lockGuard": "mise environment template validates authority pins and contracted lock/sidecar SHA256 before any child command; native locked policy controls installs",
		"installPersonalMise": false
	},
	"profiles": {
		"web": {
			"task": "setup:web",
			"tools": ["node", "pnpm"],
			"doctor": "web",
