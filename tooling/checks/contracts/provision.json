		"desktop": {
			"task": "setup:desktop",
			"tools": ["node", "pnpm", "rust", "cargoAudit"],
			"doctor": "desktop",
			"includes": "web"
		},
		"ci": {
			"task": "setup:ci",
			"tools": ["node", "pnpm"],
			"doctor": null,
			"browser": null,
			"purpose": "Frozen dependencies for web-minimum CI; full web/desktop diagnosis remains separate"
		}
	},
	"directories": {
		"defaultData": "$XDG_DATA_HOME/mise or ~/.local/share/mise",
		"auditRelativePath": "notfeed/cargo-audit/0.23.0",
