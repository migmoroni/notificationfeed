{
	"schemaVersion": 1,
	"manager": "pnpm",
	"version": "11.28.12",
	"phase": "2.3",
	"node": "22.21.1",
	"workspaces": ["apps/web", "apps/desktop", "packages/notfeed"],
	"productSpecifier": "workspace:*",
	"policies": {
		"engineStrict": true,
		"strictPeerDependencies": true,
		"strictDepBuilds": true,
		"pmOnFail": "error",
		"verifyDepsBeforeRun": "error",
		"enableGlobalVirtualStore": false
	},
	"allowBuilds": {
		"node-datachannel@0.29.0": true,
		"fsevents@2.3.3": true,
		"esbuild@0.28.2": true
	},
	"scriptReview": "Exact active lifecycle consumers: esbuild verifies binary SHA256/version, node-datachannel downloads existing N-API binary, fsevents is existing optional macOS support. Sharp 0.35.5 has no installation lifecycle and uses its declared prebuilt platform package; remove obsolete permission. Unknown scripts fail; no global allow.",
	"manifestsBefore": {
		"": {
			"name": "notfeed-app",
			"private": true,
			"version": "0.0.1",
			"type": "module",
			"scripts": {
				"dev": "npm run dev --workspace @notfeed/web --",
				"build": "npm run build --workspace @notfeed/web --",
				"preview": "npm run preview --workspace @notfeed/web --",
				"prepare": "npm run sync --workspace @notfeed/web",
				"check": "npm run check --workspace @notfeed/web --",
				"check:watch": "npm run check:watch --workspace @notfeed/web --",
				"test": "npm run test --workspace @notfeed/web --",
				"test:run": "npm run test:run --workspace @notfeed/web --",
				"check:contracts": "node tooling/migration/check.mjs",
				"lint:architecture": "node tooling/migration/lint.mjs",
				"test:gate": "node --test --experimental-test-isolation=none tooling/migration/tests/*.test.mjs",
				"gate:migration": "node tooling/migration/gate.mjs",
				"test:e2e": "playwright test --config tooling/e2e/playwright.config.ts",
				"check:e2e": "tsc -p tooling/e2e/tsconfig.json",
				"icons:gen": "npm run icons:gen --workspace @notfeed/web --",
				"tauri": "npm run tauri --workspace @notfeed/desktop --",
				"tauri:dev": "npm run tauri:dev --workspace @notfeed/desktop --",
				"tauri:build": "npm run tauri:build --workspace @notfeed/desktop --",
				"tauri:appimage": "npm run tauri:appimage --workspace @notfeed/desktop --",
				"test:e2e:dev": "playwright test --config tooling/e2e/playwright.dev.config.ts",
				"test:e2e:upgrade": "node tooling/e2e/reproduce-reference.mjs && node tooling/e2e/upgrade.mjs --reproduced"
			},
			"devDependencies": {
				"@playwright/test": "1.65.1",
				"@types/node": "^25.6.0",
				"semver": "7.8.6",
				"svelte": "^5.53.5",
				"typescript": "^5.9.3",
				"vitest": "^4.0.18"
			},
			"workspaces": ["apps/web", "apps/desktop", "packages/notfeed"],
			"engines": {
				"node": ">=22.21.1",
				"npm": ">=11.11.1"
			}
		},
		"apps/web": {
			"name": "@notfeed/web",
			"private": true,
			"version": "0.0.1",
			"type": "module",
			"scripts": {
				"dev": "vite dev",
				"build": "vite build",
				"preview": "vite preview",
				"sync": "svelte-kit sync",
				"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
				"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
				"test": "vitest",
				"test:run": "node ../../tooling/migration/unit.mjs",
				"icons:gen": "node scripts/generate-icons.mjs"
			},
			"devDependencies": {
				"@internationalized/date": "^3.11.0",
				"@lucide/svelte": "^0.561.0",
				"@sveltejs/adapter-auto": "^7.0.0",
				"@sveltejs/adapter-static": "^3.0.10",
				"@sveltejs/kit": "^2.50.2",
				"@sveltejs/vite-plugin-svelte": "^6.2.4",
				"@tailwindcss/vite": "^4.1.18",
				"@testing-library/svelte": "^5.3.1",
				"@types/node": "^25.6.0",
				"autoprefixer": "^10.4.24",
				"jsdom": "^28.1.0",
				"postcss": "^8.5.6",
				"sharp": "^0.34.5",
				"svelte": "^5.53.5",
				"svelte-check": "^4.3.6",
				"tailwindcss": "^4.1.18",
				"tw-animate-css": "^1.4.0",
				"typescript": "^5.9.3",
				"vite": "^7.3.2",
				"vitest": "^4.0.18",
				"workbox-precaching": "^7.4.0",
				"workbox-routing": "^7.4.0",
				"workbox-window": "^7.4.0"
			},
			"dependencies": {
				"@tauri-apps/plugin-shell": "^2.3.5",
				"@notfeed/product": "0.0.1"
			}
		},
		"apps/desktop": {
			"name": "@notfeed/desktop",
			"private": true,
			"version": "0.0.1",
			"type": "module",
			"scripts": {
				"tauri": "tauri",
				"tauri:dev": "tauri dev",
				"tauri:build": "tauri build",
				"tauri:appimage": "tauri build --bundles appimage"
			},
			"devDependencies": {
				"@tauri-apps/cli": "^2.10.1"
			}
		},
		"packages/notfeed": {
			"name": "@notfeed/product",
			"version": "0.0.1",
			"private": true,
			"type": "module",
			"exports": {
				".": "./src/index.ts",
				"./*.js": "./src/*.ts",
				"./*.svelte": "./src/*.svelte",
				"./*.svg": "./src/*.svg"
			},
			"dependencies": {
				"@helia/ipns": "^9.2.1",
				"@helia/unixfs": "^7.2.1",
				"@libp2p/peer-id": "6.0.18",
				"@lucide/svelte": "^0.561.0",
				"@tauri-apps/api": "^2.10.1",
				"@tauri-apps/plugin-http": "^2.5.8",
				"@tauri-apps/plugin-notification": "^2.3.3",
				"@tauri-apps/plugin-process": "^2.3.1",
				"@tauri-apps/plugin-updater": "^2.10.1",
				"bits-ui": "^2.15.5",
				"clsx": "^2.1.1",
				"helia": "^6.1.4",
				"multiformats": "14.0.6",
				"tailwind-merge": "^3.4.0",
				"tailwind-variants": "^3.2.2"
			},
			"peerDependencies": {
				"svelte": "^5.53.5",
				"@sveltejs/kit": "^2.50.2"
			},
			"devDependencies": {
				"vitest": "^4.0.18"
			}
		}
	},
	"graphContract": "Compare canonical names/versions and consumer edges from npm lock against pnpm list --recursive --lockfile-only --depth Infinity --json. Every delta requires a reviewed mapping before gate. Frozen clean install and cached offline repeat must preserve locks; actual consumers run in that candidate.",
	"sources": [
		"https://github.com/pnpm/pnpm/blob/main/pnpm11/docs/cli/import.md",
		"https://github.com/pnpm/pnpm/blob/main/pnpm11/docs/cli/list.md",
		"https://github.com/pnpm/pnpm/blob/main/pnpm11/docs/settings/build.md",
		"https://github.com/pnpm/pnpm/blob/main/pnpm11/docs/settings/cli.md"
	],
	"releaseAgeExceptions": [
		"svelte@5.59.1",
		"baseline-browser-mapping@2.11.39",
		"tailwind-merge@3.7.1"
	],
	"releaseAgeExceptionReason": "Exact targets selected during 2.1 only: Svelte security/compatibility patch, browser compatibility dataset, and compatible Tailwind class merger patch. pnpm 11 automatically records explicit recent selections under its non-strict default maturity preference; official metadata/integrity and absence of install lifecycle for tailwind-merge reviewed. No name/glob exception, advisory ignore, integrity/TLS/peer/script relaxation; online security policy mandatory.",
	"overrides": {
		"source-map-js@": "1.2.4",
		"undici@": "7.30.2"
	}
}
