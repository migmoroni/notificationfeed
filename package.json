{
	"name": "notfeed-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @notfeed/web dev",
		"build": "pnpm --filter @notfeed/web build",
		"preview": "pnpm --filter @notfeed/web preview",
		"prepare": "pnpm --filter @notfeed/web sync",
		"check": "pnpm --filter @notfeed/web check",
		"check:watch": "pnpm --filter @notfeed/web check:watch",
		"test": "pnpm --filter @notfeed/web test",
		"test:run": "pnpm --filter @notfeed/web test:run",
		"test:e2e": "playwright test --config tooling/e2e/playwright.config.ts",
		"check:e2e": "tsc -p tooling/e2e/tsconfig.json",
		"icons:gen": "pnpm --filter @notfeed/web icons:gen",
		"tauri": "pnpm --filter @notfeed/desktop tauri",
		"tauri:dev": "pnpm --filter @notfeed/desktop tauri:dev",
		"tauri:build": "pnpm --filter @notfeed/desktop tauri:build",
		"tauri:appimage": "pnpm --filter @notfeed/desktop tauri:appimage",
		"test:e2e:dev": "playwright test --config tooling/e2e/playwright.dev.config.ts",
		"test:e2e:upgrade": "node tooling/e2e/reproduce-reference.mjs && node tooling/e2e/upgrade.mjs --reproduced",
		"check:architecture": "node tooling/checks/architecture.mjs",
		"check:restrictions": "node tooling/checks/restrictions.mjs",
		"check:contracts": "node tooling/checks/contracts.mjs",
		"test:tooling": "node --test --test-reporter=tap --experimental-test-isolation=none tooling/checks/tests/*.test.mjs",
		"lint": "eslint . --max-warnings 0",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"pwa:preview": "pnpm build && pnpm preview --host 127.0.0.1",
		"doctor": "node tooling/checks/doctor.mjs",
		"verify:quick": "node tooling/checks/verify.mjs quick",
		"verify:integration": "node tooling/checks/verify.mjs integration",
		"check:rust": "node tooling/checks/verify.mjs rust",
		"security:collect": "node tooling/checks/security.mjs collect",
		"security:check": "node tooling/checks/security.mjs check",
		"artifacts:clean": "node tooling/checks/artifacts.mjs"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.1",
		"@types/node": "24.19.2",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"semver": "7.8.6",
		"svelte": "5.59.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.73.0",
		"vitest": "4.1.12"
	},
	"engines": {
		"node": "24.22.3",
		"pnpm": "11.28.12"
	},
	"packageManager": "pnpm@11.28.12"
}
