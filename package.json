{
  "name": "notfeed-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @notfeed/web --",
    "build": "npm run build --workspace @notfeed/web --",
    "preview": "npm run preview --workspace @notfeed/web --",
    "prepare": "npm run sync --workspace @notfeed/web",
    "check": "npm run check --workspace @notfeed/web --",
    "check:watch": "npm run check:watch --workspace @notfeed/web --",
    "test": "npm run test --workspace @notfeed/web --",
    "test:run": "npm run test:run --workspace @notfeed/web --",
    "check:contracts": "node tooling/migration/check.mjs",
    "lint:architecture": "node tooling/migration/lint.mjs",
    "test:gate": "node --test --experimental-test-isolation=none tooling/migration/tests/*.test.mjs",
    "gate:migration": "node tooling/migration/gate.mjs",
    "test:e2e": "playwright test --config tooling/e2e/playwright.config.ts",
    "check:e2e": "tsc -p tooling/e2e/tsconfig.json",
    "icons:gen": "npm run icons:gen --workspace @notfeed/web --",
    "tauri": "npm run tauri --workspace @notfeed/desktop --",
    "tauri:dev": "npm run tauri:dev --workspace @notfeed/desktop --",
    "tauri:build": "npm run tauri:build --workspace @notfeed/desktop --",
    "tauri:appimage": "npm run tauri:appimage --workspace @notfeed/desktop --",
    "test:e2e:dev": "playwright test --config tooling/e2e/playwright.dev.config.ts",
    "test:e2e:upgrade": "node tooling/e2e/reproduce-reference.mjs && node tooling/e2e/upgrade.mjs --reproduced"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^25.6.0",
    "svelte": "^5.53.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/notfeed"
  ],
  "engines": {
    "node": ">=22.21.1",
    "npm": ">=11.11.1"
  }
}
